@page "/history"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Staff,Admin")]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Transaction History</PageTitle>

<div class="staff-interface">
    <div class="page-header">
        <div>
            <p class="eyebrow">History</p>
            <h3>Previous Transactions</h3>
        </div>
        <button class="btn btn-secondary" type="button" @onclick="BackToDesk">Back To Desk</button>
    </div>

    @if (isLoading)
    {
        <div class="empty-panel">
            <p>Loading Transaction History...</p>
        </div>
    }
    else if (history.Count == 0)
    {
        <div class="empty-panel">
            <p>No Completed Or Missed Appointments Have Been Recorded Yet.</p>
        </div>
    }
    else
    {
        <div class="history-layout hide-on-mobile show-on-desktop">
            <div class="table-wrap">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Queue</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dayGroup in GetHistoryByDate())
                        {
                            <tr class="history-date-row"><th colspan="7">@dayGroup.Key.ToString("dddd, dd MMMM yyyy")</th></tr>
                            @foreach (var item in dayGroup)
                            {
                                <tr class="@(selectedItem?.Id == item.Id ? "selected-row" : string.Empty)" @onclick="() => SelectItem(item)">
                                    <td>@item.CustomerName</td>
                                    <td>@item.ServiceName</td>
                                    <td>@item.QueueCode</td>
                                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.TimeSlot</td>
                                    <td>@(item.ServiceDurationMinutes.HasValue ? $"{item.ServiceDurationMinutes} min" : "---")</td>
                                    <td>
                                        <span class="status-badge status-@item.Status.ToString().ToLower()">@GetStatusLabel(item.Status)</span>
                                    </td>
                                </tr>
                                @if (selectedItem?.Id == item.Id)
                                {
                                    <tr class="history-detail-row">
                                        <td colspan="7">
                                            <div class="history-detail-dropdown">
                                                <div class="history-detail-heading">
                                                    <div>
                                                        <span class="mini-label">Customer details</span>
                                                        <h4>@item.CustomerName</h4>
                                                    </div>
                                                    <span class="status-badge status-@item.Status.ToString().ToLower()">@GetStatusLabel(item.Status)</span>
                                                </div>
                                                <dl class="history-details-grid">
                                                    <div><dt>Queue</dt><dd>@item.QueueCode</dd></div>
                                                    <div><dt>Service</dt><dd>@item.ServiceName (@item.ServiceCode)</dd></div>
                                                    <div><dt>Branch</dt><dd>@item.BranchName</dd></div>
                                                    <div><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(item.CustomerEmail) ? "—" : item.CustomerEmail)</dd></div>
                                                    <div><dt>Phone</dt><dd>@item.CustomerPhone</dd></div>
                                                    <div><dt>Date and time</dt><dd>@item.AppointmentDate.ToString("dd MMM yyyy") · @item.TimeSlot</dd></div>
                                                    <div><dt>Duration</dt><dd>@(item.ServiceDurationMinutes.HasValue ? $"{item.ServiceDurationMinutes} minutes" : "—")</dd></div>
                                                    <div><dt>Served</dt><dd>@(item.ServedAt.HasValue ? item.ServedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")</dd></div>
                                                </dl>
                                                @if (item.Status == AppointmentStatus.Missed || item.Status == AppointmentStatus.Served)
                                                {
                                                    <button class="btn btn-warning" @onclick:stopPropagation="true" @onclick="() => RecallQueue(item.Id)">Recall to Queue</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <div class="mobile-history-list show-on-mobile hide-on-desktop">
            @foreach (var dayGroup in GetHistoryByDate())
            {
                <section class="mobile-history-day">
                    <h4 class="history-date-heading">@dayGroup.Key.ToString("dddd, dd MMMM yyyy")</h4>
                    @foreach (var item in dayGroup)
                    {
                        <div class="mobile-history-card @(selectedItem?.Id == item.Id ? "selected-card" : "")" @onclick="() => SelectItem(item)">
                            <div class="mobile-history-header">
                                <span class="mobile-history-code">@item.QueueCode</span>
                                <div class="mobile-history-meta">
                                    <span class="status-badge status-@item.Status.ToString().ToLower()">@GetStatusLabel(item.Status)</span>
                                </div>
                            </div>
                            <div class="mobile-history-info">
                                <span class="mobile-cust-name">@item.CustomerName</span>
                                <span class="mobile-svc-tag">@item.ServiceName</span>
                            </div>
                            <div class="mobile-history-footer">
                                <span>@item.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <span>@(item.ServiceDurationMinutes.HasValue ? $"{item.ServiceDurationMinutes} min" : "---")</span>
                            </div>
                            @if (selectedItem?.Id == item.Id)
                            {
                                <div class="history-detail-dropdown mobile-history-details" @onclick:stopPropagation="true">
                                    <dl class="history-details-grid">
                                        <div><dt>Queue</dt><dd>@item.QueueCode</dd></div>
                                        <div><dt>Service</dt><dd>@item.ServiceName (@item.ServiceCode)</dd></div>
                                        <div><dt>Branch</dt><dd>@item.BranchName</dd></div>
                                        <div><dt>Email</dt><dd>@(string.IsNullOrWhiteSpace(item.CustomerEmail) ? "—" : item.CustomerEmail)</dd></div>
                                        <div><dt>Phone</dt><dd>@item.CustomerPhone</dd></div>
                                        <div><dt>Date and time</dt><dd>@item.AppointmentDate.ToString("dd MMM yyyy") · @item.TimeSlot</dd></div>
                                        <div><dt>Duration</dt><dd>@(item.ServiceDurationMinutes.HasValue ? $"{item.ServiceDurationMinutes} minutes" : "—")</dd></div>
                                        <div><dt>Served</dt><dd>@(item.ServedAt.HasValue ? item.ServedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")</dd></div>
                                    </dl>
                                    @if (item.Status == AppointmentStatus.Missed || item.Status == AppointmentStatus.Served)
                                    {
                                        <button class="btn btn-warning w-100" @onclick="() => RecallQueue(item.Id)">Recall to Queue</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private List<AppointmentHistoryItem> history = new();
    private AppointmentHistoryItem? selectedItem;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            history = await Http.GetFromJsonAsync<List<AppointmentHistoryItem>>("staff/history") ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectItem(AppointmentHistoryItem item)
    {
        selectedItem = selectedItem?.Id == item.Id ? null : item;
    }

    private IEnumerable<IGrouping<DateTime, AppointmentHistoryItem>> GetHistoryByDate() =>
        history.GroupBy(item => item.AppointmentDate.Date)
            .OrderByDescending(group => group.Key);

    private void BackToDesk()
    {
        Navigation.NavigateTo("/staff");
    }

    private async Task RecallQueue(int appointmentId)
    {
        await Http.PostAsync($"staff/queue/{appointmentId}/recall", null);
        history = await Http.GetFromJsonAsync<List<AppointmentHistoryItem>>("staff/history") ?? new();
        selectedItem = null;
    }

    private static string GetStatusLabel(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Waiting => "Waiting",
            AppointmentStatus.Called => "Called",
            AppointmentStatus.Serving => "Serving",
            AppointmentStatus.Served => "Served",
            AppointmentStatus.Missed => "Missed",
            _ => status.ToString()
        };
    }
}
