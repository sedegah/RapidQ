@page "/customer"
@inject HttpClient Http

<PageTitle>Customer Service</PageTitle>

<div class="customer-page">
    <div class="customer-hero">
        <div>
            <p class="eyebrow">Main Branch</p>
            <h1>Request A Queue Ticket</h1>
        </div>
        <div class="hero-badge">
            <span>Next Available Window</span>
            <strong>@nextAvailableWindow</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="ticket-box">
            <p class="ticket-label">Your Ticket Code</p>
            <h2>@ticketCode</h2>
            <p>@successMessage</p>
            @if (expectedTime.HasValue)
            {
                <p><strong>Expected Time:</strong> @expectedTime.Value.ToString("ddd, dd MMM yyyy | hh:mm tt")</p>
            }
            <a href="/track/@ticketCode" class="btn btn-primary mt-3">Track My Ticket</a>
        </div>
    }

    <div class="customer-shell">
        <div class="customer-panel">
            <div class="panel-header">
                <h3>Customer Details</h3>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleSubmit">
                <div class="form-grid">
                    <div class="field-group">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="model.CustomerName" />
                    </div>

                    <div class="field-group">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="model.CustomerEmail" />
                    </div>

                    <div class="field-group">
                        <label class="form-label">Phone Number</label>
                        <InputText class="form-control" @bind-Value="model.CustomerPhone" />
                    </div>

                    <div class="field-group">
                        <label class="form-label">Service Type</label>
                        <InputSelect class="form-select" @bind-Value="model.ServiceId">
                            <option value="0">Select Service</option>
                            @foreach (var service in services)
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field-group">
                        <label class="form-label">Preferred Time</label>
                        <input type="time" class="form-control" min="09:00" max="16:45" step="900" value="@model.TimeSlot" @onchange="OnTimeChanged" />
                    </div>

                    <div class="field-group full-width">
                        <label class="form-label">Preferred Date</label>
                        <input type="date"
                               class="form-control"
                               value="@model.AppointmentDate.ToString("yyyy-MM-dd")"
                               min="@GetMinDate()"
                               @onchange="OnDateChanged" />
                    </div>
                </div>

                <button class="btn btn-primary action-button" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Processing..." : "Get Queue Ticket")
                </button>
            </EditForm>
        </div>

        <aside class="info-panel">
            <div class="info-card-block support-card">
                <span class="mini-label">Branch Support</span>
                <h4>Services Available</h4>
                <ul>
                    <li>Teller Services</li>
                    <li>Account Opening</li>
                    <li>Loan Support</li>
                    <li>Card Services</li>
                </ul>
            </div>
        </aside>
    </div>
</div>

@code {
    private CreateAppointmentRequest model = new()
    {
        AppointmentDate = GetNextBusinessDay(DateTime.Today),
        TimeSlot = "09:00",
        BranchId = 1
    };

    private readonly List<ServiceItem> services = new();
    private bool isSubmitting;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string ticketCode = string.Empty;
    private DateTime? expectedTime;
    private string nextAvailableWindow = "Please wait";

    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
        await LoadNextAvailableWindow();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(rawValue) || !DateTime.TryParse(rawValue, out var selectedDate))
        {
            return;
        }

        if (!AppointmentScheduling.IsBusinessDay(selectedDate))
        {
            errorMessage = "Appointments are available Monday to Friday only.";
            model.AppointmentDate = GetNextBusinessDay(selectedDate);
            return;
        }

        errorMessage = string.Empty;
        model.AppointmentDate = selectedDate;
    }

    private void OnTimeChanged(ChangeEventArgs e)
    {
        var selectedTime = e.Value?.ToString() ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(selectedTime) && !AppointmentScheduling.IsWithinBusinessHours(selectedTime))
        {
            errorMessage = "Please select a preferred time between 09:00 and 17:00 during office hours.";
            model.TimeSlot = string.Empty;
            return;
        }

        errorMessage = string.Empty;
        model.TimeSlot = selectedTime;
    }

    private static DateTime GetNextBusinessDay(DateTime date)
    {
        while (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            date = date.AddDays(1);
        }

        return date;
    }

    private static string GetMinDate()
    {
        return DateTime.Today.ToString("yyyy-MM-dd");
    }

    private async Task LoadServices()
    {
        try
        {
            services.Clear();
            var loadedServices = await Http.GetFromJsonAsync<List<ServiceItem>>("https://localhost:7041/client/services") ?? new();
            services.AddRange(loadedServices);
        }
        catch
        {
            errorMessage = "The service list is currently unavailable. Please try again shortly.";
        }
    }

    private async Task LoadNextAvailableWindow()
    {
        try
        {
            var summary = await Http.GetFromJsonAsync<DashboardSummary>("https://localhost:7041/staff/dashboard") ?? new DashboardSummary();
            nextAvailableWindow = summary.ActiveQueue switch
            {
                0 => "Now",
                <= 2 => $"Within {Math.Max(3, summary.AverageWaitMinutes)} minutes",
                <= 5 => $"Within {Math.Max(5, summary.AverageWaitMinutes)} minutes",
                _ => $"Within {Math.Max(10, summary.AverageWaitMinutes)} minutes"
            };
        }
        catch
        {
            nextAvailableWindow = "Checking desk";
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.CustomerName))
        {
            errorMessage = "Please enter your full name.";
            isSubmitting = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(model.CustomerPhone))
        {
            errorMessage = "Please enter a phone number.";
            isSubmitting = false;
            return;
        }

        if (model.ServiceId <= 0)
        {
            errorMessage = "Please select a service.";
            isSubmitting = false;
            return;
        }

        if (!AppointmentScheduling.IsBusinessDay(model.AppointmentDate))
        {
            errorMessage = "Appointments are available Monday to Friday only.";
            isSubmitting = false;
            return;
        }

        if (!AppointmentScheduling.IsWithinBusinessHours(model.TimeSlot))
        {
            errorMessage = "Please select a preferred time between 09:00 and 17:00 during office hours.";
            isSubmitting = false;
            return;
        }

        try
        {
            model.BranchId = 1;
            var response = await Http.PostAsJsonAsync("https://localhost:7041/client/tickets", model);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<QueueTicketResponse>();
                ticketCode = result?.QueueCode ?? string.Empty;
                expectedTime = result?.ExpectedTime ?? DateTime.Now;
                successMessage = $"Ticket confirmed for {result?.ServiceName}. Please keep your phone ready for the service desk.";
                model = new CreateAppointmentRequest { AppointmentDate = GetNextBusinessDay(DateTime.Today), TimeSlot = "09:00", BranchId = 1 };
            }
            else
            {
                var message = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrWhiteSpace(message) ? "Queue request could not be processed." : message;
            }
        }
        catch
        {
            errorMessage = "The queue API is not available. Please try again later.";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private class QueueTicketResponse
    {
        public int QueueNumber { get; set; }
        public string QueueCode { get; set; } = string.Empty;
        public string ServiceName { get; set; } = string.Empty;
        public DateTime ExpectedTime { get; set; }
    }
}
